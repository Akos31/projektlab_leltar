<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="InventoryApp.Client.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:InventoryApp.Client"
    Shell.FlyoutBehavior="Disabled"
    Title="InventoryApp.Client">

    <ShellContent
        Title="Bejelentkezés"
        ContentTemplate="{DataTemplate local:LoginPage}"
        Route="LoginPage" />

    <TabBar Route="main">
        <ShellContent
            Title="Beolvasás"
            ContentTemplate="{DataTemplate local:ScanPage}"
            Route="ScanPage" />
        <ShellContent
            Title="Eszközök"
            ContentTemplate="{DataTemplate local:AssetsPage}"
            Route="AssetsPage" />
        <ShellContent
            Title="Importálás"
            ContentTemplate="{DataTemplate local:ImportPage}"
            Route="ImportPage" />
    </TabBar>
</Shell>