<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="InventoryApp.Client.ScanPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Beolvasás">

    <VerticalStackLayout Padding="32" Spacing="16" VerticalOptions="Center">

        <Entry x:Name="CodeEntry"
               Placeholder="Leltárszám / kód"
               ReturnType="Done" />

        <Button Text="Beolvasás" Clicked="OnScanClicked" />

    </VerticalStackLayout>
</ContentPage>