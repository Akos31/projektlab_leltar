<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="InventoryApp.Client.ScanPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Beolvasás">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">

            <Label Text="Leltárkörzet" FontAttributes="Bold" />
            <Picker x:Name="ZonePicker" Title="Válassz körzetet"
                ItemDisplayBinding="{Binding Display}"
                SelectedIndexChanged="OnZoneChanged" />
            <Label x:Name="PeriodLabel" />
            <HorizontalStackLayout Spacing="8">
                <Button x:Name="OpenPeriodButton" Text="Időszak indítása"
            IsEnabled="False" Clicked="OnOpenPeriod" />
                <Button x:Name="ClosePeriodButton" Text="Időszak lezárása"
            IsEnabled="False" Clicked="OnClosePeriod" />
            </HorizontalStackLayout>

            <Label Text="Helyiség" FontAttributes="Bold" />
            <Picker x:Name="RoomPicker" Title="Válassz helyiséget"
                ItemDisplayBinding="{Binding RoomNumber}"
                SelectedIndexChanged="OnRoomChanged" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Entry x:Name="NewRoomEntry" Placeholder="Új helyiség száma" />
                <Button Grid.Column="1" Text="Felvesz" Clicked="OnAddRoom" />
            </Grid>

            <BoxView HeightRequest="1" Color="LightGray" />

            <Label Text="Kód beolvasása" FontAttributes="Bold" />
            <Entry x:Name="CodeEntry" Placeholder="Leltárszám / vonalkód"
               IsEnabled="False" Completed="OnScan" />
            <Button x:Name="ScanButton" Text="Beolvasás" IsEnabled="False" Clicked="OnScan" />

            <Border x:Name="ResultCard" IsVisible="False" Padding="12" StrokeThickness="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>
                <Label x:Name="ResultLabel" TextColor="White" FontSize="16" />
            </Border>

            <Label x:Name="StatusLabel" TextColor="Gray" />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
    
